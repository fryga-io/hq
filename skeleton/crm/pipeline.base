filters:
  and:
    - file.hasTag("crm")
    - 'file.ext == "md"'

properties:
  pipeline:
    displayName: Stage
  grade:
    displayName: Grade

views:
  - type: table
    name: "Pipeline"
    order:
      - file.name
      - pipeline
      - grade
      - created
    groupBy:
      property: pipeline
      direction: ASC
